# Tested on RTX 3090, torch 2.6.0+cu124, Triton 3.2.0.
HVS_RL_PRECISION=bf16_merged
SMALL_LIVE_FAST_START=1
SMALL_LIVE_FAST_TAIL_S=0.5
SMALL_LIVE_FAST_TAIL_WORDS=3
SMALL_LIVE_SCORE_FRACTION=0.5
HVS_SEMANTIC_CUDA_GRAPH=1
HVS_SEMANTIC_COMPILE=1
HVS_SEMANTIC_BUCKET=512
HVS_SEMANTIC_BANKS=2
HVS_FAST_SAMPLE=1
# The upstream compiled sampler fails on torch 2.6; use its Triton implementation.
HVS_LOCAL_COMPILE=0
HVS_LOCAL_TRITON=1
HVS_CODEC_GRAPH=1
HVS_CODEC_FUSED=1
HVS_CODEC_RESET_GRAPH=1
# Padded prefill graphs were faster, but altered sampled speech in the pilot.
# Keep the unchanged eager prefill as production default.
HVS_PREFILL_GRAPH=0
HVS_CHUNK_RAMP=1
HVS_RAMP_START=3
HUMANENESS_PRELOAD_EXPERIMENTAL=1
SMALL_BOUNDARY_ASR_URL=http://127.0.0.1:8822
