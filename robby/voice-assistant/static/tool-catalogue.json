    {
      "type": "function",
      "function": {
        "name": "search_web",
        "description": "Search the public web for a short topical query. Use for implicit look-it-up requests and topics outside encyclopedia/news/weather; infer the topic from recent dialogue. Returns real source annotations. Billed through OpenRouter.",
        "strict": true,
        "parameters": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string"
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "search_news",
        "description": "Find latest headlines, optionally filter recent feeds by topic. For latest/current headlines without a specific TOPIC use an empty query, never generic headline words.",
        "strict": true,
        "parameters": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string"
            },
            "source": {
              "type": "string",
              "enum": [
                "all",
                "Tagesschau",
                "BBC News",
                "Deutsche Welle",
                "Deutschlandfunk",
                "The Guardian"
              ]
            }
          },
          "required": [
            "query",
            "source"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "get_weather",
        "description": "Get a current weather model estimate and 3-day forecast for a named city. Ask the user if no city is known.",
        "strict": true,
        "parameters": {
          "type": "object",
          "properties": {
            "location": {
              "type": "string"
            }
          },
          "required": [
            "location"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "search_wikipedia",
        "description": "Search Wikipedia for a concise encyclopedia extract, with source links.",
        "strict": true,
        "parameters": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string"
            },
            "language": {
              "type": "string",
              "enum": [
                "de",
                "en"
              ]
            }
          },
          "required": [
            "query",
            "language"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "set_interruption_rule",
        "description": "Register an explicitly requested live condition for interrupting the current user BEFORE their turn ends.",
        "strict": true,
        "parameters": {
          "type": "object",
          "properties": {
            "condition": {
              "type": "string",
              "description": "The agreed condition, e.g. user talks about bananas."
            },
            "trigger_terms": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Literal words/inflections, e.g. Banane, Bananen, banana, bananas."
            },
            "match_mode": {
              "type": "string",
              "enum": [
                "any_term"
              ]
            },
            "reply": {
              "type": "string",
              "description": "Exact brief spoken interruption, e.g. Stopp, stopp!"
            }
          },
          "required": [
            "condition",
            "trigger_terms",
            "match_mode",
            "reply"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "set_semantic_interruption_rule",
        "description": "Register an explicitly requested meaning-dependent condition, ONLY when literal named topic/word triggers are insufficient. Requires the decision API during live speech.",
        "strict": true,
        "parameters": {
          "type": "object",
          "properties": {
            "condition": {
              "type": "string"
            },
            "reply": {
              "type": "string"
            }
          },
          "required": [
            "condition",
            "reply"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "clear_interruption_rules",
        "description": "Cancel the current user’s explicitly cancelled interruption game/rules.",
        "strict": true,
        "parameters": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        }
      }
    }
  ],
  "internal_routing_tool": {
    "type": "function",
    "function": {
      "name": "use_tools",
      "description": "Use real capabilities to fulfil the current request: avatar choreography or public information lookup. Resolve implicit requests from conversation. Call BEFORE speaking; do not use for mere quotes, negated requests, stories or capability questions.",
      "parameters": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "avatar",
              "lookup"
            ]
          }
        },
        "required": [
          "kind"
        ],
        "additionalProperties": false
      }
    }
  },
